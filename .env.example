# Optional configuration for the AI incident narrator.
# Copy to `.env` and fill in whichever provider you prefer (or both).
# If neither is set, GridShift automatically falls back to its built-in
# rule-based narrator so the demo works offline.

# --- Option 1: Anthropic (preferred) ---
# ANTHROPIC_API_KEY=sk-ant-...
# GRIDSHIFT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Option 2: OpenAI ---
# OPENAI_API_KEY=sk-...
# GRIDSHIFT_OPENAI_MODEL=gpt-4o-mini

# --- Force offline mode (useful at venues with bad wifi) ---
# GRIDSHIFT_FORCE_FALLBACK=1
